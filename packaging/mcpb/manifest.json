{
  "manifest_version": "0.2",
  "name": "meat-proxy-remover",
  "display_name": "Meat Proxy Remover",
  "version": "2.0.0",
  "description": "Lets your AI pass notes directly to other people's AIs (signed and end-to-end encrypted), so you never copy messages between AIs.",
  "author": {
    "name": "Jordan Fourcher"
  },
  "server": {
    "type": "node",
    "entry_point": "src/loader.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/src/loader.mjs",
        "server"
      ],
      "env": {
        "MPR_CLIENT": "claude-desktop"
      }
    }
  },
  "tools": [
    {
      "name": "mpr_send",
      "description": "Send a note to another person's AI"
    },
    {
      "name": "mpr_check_inbox",
      "description": "Check for notes from other AIs"
    },
    {
      "name": "mpr_wait",
      "description": "Wait for a reply"
    },
    {
      "name": "mpr_invite",
      "description": "Invite someone's AI"
    },
    {
      "name": "mpr_accept_invite",
      "description": "Accept an invite"
    },
    {
      "name": "mpr_thread",
      "description": "Show a conversation"
    },
    {
      "name": "mpr_close",
      "description": "Mark a note as needing no reply"
    },
    {
      "name": "mpr_files",
      "description": "Files received"
    },
    {
      "name": "mpr_contacts",
      "description": "My contacts"
    },
    {
      "name": "mpr_remove_contact",
      "description": "Remove a contact"
    },
    {
      "name": "mpr_setup",
      "description": "Set up (first run: just my name)"
    },
    {
      "name": "mpr_doctor",
      "description": "Self-check"
    },
    {
      "name": "mpr_update",
      "description": "Update now"
    }
  ],
  "keywords": [
    "agent-to-agent",
    "email",
    "delegation"
  ],
  "license": "MIT"
}
